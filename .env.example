# Copia este archivo como .env y ajusta los valores a tu máquina:
#   cp .env.example .env

# Ruta del binario de Chromium/Chrome
# Linux: /usr/bin/chromium | macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_BINARY=/usr/bin/chromium

# Ruta del chromedriver (debe coincidir con la versión del navegador)
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Directorio de perfil de Chrome donde se guarda la sesión de Deskbird.
# Si lo dejas vacío, se usa un perfil temporal y tendrás que iniciar sesión cada vez.
CHROME_USER_DATA_DIR=/home/tu_usuario/.config/chromium

# Nombre del perfil dentro del directorio anterior
CHROME_PROFILE=Default
